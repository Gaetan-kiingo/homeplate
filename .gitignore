# Dependencies
node_modules/

# Environment — never commit real secrets (build-plan §5.11). .env.example IS committed.
.env
.env.*
!.env.example

# Local TLS material (generated by scripts/gen-dev-certs.sh — NFR-03)
certs/

# Test / build output — root-anchored: tests/coverage/ is a verification lane, not output
/coverage/
client/dist/

# Logs and OS noise
*.log
.DS_Store

# Editor / R session noise
.Rhistory
