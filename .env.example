# Homeplate v1.0 — environment template (U1-CONFIG; build-plan §5.11: no secrets in code).
# Copy to `.env` and adjust. Every variable the config schema can require is enumerated here;
# `npm run build` (scripts/check-build.js) verifies this file still satisfies the schema.
# NEVER commit a real `.env` — .gitignore excludes it.

# ---- runtime mode ----------------------------------------------------------------------------
NODE_ENV=development

# ---- server / transport (NFR-03, AB-05) ------------------------------------------------------
PORT=3000
# Self-signed dev cert: run scripts/gen-dev-certs.sh (certs/ is git-ignored).
TLS_CERT_PATH=certs/dev-cert.pem
TLS_KEY_PATH=certs/dev-key.pem
# HTTPS/TLS 1.2+ enforcement. May be 'false' ONLY for local tooling; fails closed in production.
ENFORCE_HTTPS=true

# ---- stores (SRS §2.4: PostgreSQL source of truth; Redis sessions + read cache only) ---------
DATABASE_URL=postgres://homeplate:homeplate@localhost:5432/homeplate
REDIS_URL=redis://localhost:6379/0

# ---- field-level encryption at rest (NFR-13) -------------------------------------------------
# 32 bytes hex for AES-256-GCM. Generate your own: openssl rand -hex 32
# (The value below is a deliberately fake dev placeholder.)
FIELD_ENCRYPTION_KEY=deadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeefdeadbeef

# ---- auth (ADR-006; NFR-04/NFR-05: lock after 5 failed attempts in 10 minutes) ---------------
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=600
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_NAME=hp.sid
# FR-10 — email-verification tokens older than this are rejected with 400.
EMAIL_TOKEN_TTL_HOURS=24

# ---- booking (FR-12 — per-guest concurrent pending-booking cap) ------------------------------
BOOKING_MAX_CONCURRENT_PENDING=3

# ---- privacy / data lifecycle (NFR-12, NFR-13, ADR-010) --------------------------------------
PRIVACY_ERASURE_DAYS=30
PRIVACY_INACTIVITY_MONTHS=24
PRIVACY_COARSEN_RADIUS_METERS=300

# ---- external adapter resilience (NFR-09) ----------------------------------------------------
ADAPTER_TIMEOUT_MS=3000
ADAPTER_RETRY_MAX=2
ADAPTER_BACKOFF_BASE_MS=200

# ---- outbox worker (ADR-001/ADR-003) ---------------------------------------------------------
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=10
OUTBOX_MAX_ATTEMPTS=8
OUTBOX_BACKOFF_BASE_MS=5000
OUTBOX_BACKOFF_MAX_MS=3600000

# ---- notifications (ADR-011 — SendGrid email is the v1.0 channel; push OFF by default) -------
# mock | sendgrid. Dev/test default: mock (records NOTIFICATION_ATTEMPT rows, sends nothing).
NOTIFICATIONS_TRANSPORT=mock
NOTIFICATIONS_PUSH_ENABLED=false
# Required when NOTIFICATIONS_TRANSPORT=sendgrid (production):
#SENDGRID_API_KEY=
#SENDGRID_FROM_EMAIL=
# Required only when push is enabled in production (ADR-011 gates it off in v1.0):
#FCM_SERVICE_ACCOUNT_JSON=

# ---- maps / places (ADR-005; Redis-cached at PUBLIC precision only per ADR-010) --------------
# mock | live. Dev/test default: mock.
MAPS_MODE=mock
MAPS_CACHE_TTL_SECONDS=86400
# Required when MAPS_MODE=live:
#MAPS_API_KEY=

# ---- moderation LLM (ADR-007 — provider-agnostic; Google Gemini free tier configured via env,
# ---- never hardcoded. CI and the automated suite always run the deterministic mock.) ---------
# mock | live. Dev/test default: mock. Only the IT-03 measurement run uses live.
LLM_MODERATION_MODE=mock
# FR-08 / ADR-002 — classifications below this confidence go to the human moderator queue.
# Must be in (0, 1].
MODERATION_CONFIDENCE_THRESHOLD=0.8
# Required when LLM_MODERATION_MODE=live:
#LLM_MODERATION_BASE_URL=https://generativelanguage.googleapis.com
#LLM_MODERATION_API_KEY=
#MODERATION_MODEL=

# ---- object storage (ADR-004 — media referenced by key, per-object delete; MinIO locally) ----
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=homeplate-media
# MinIO local defaults from docker-compose.yml — not real credentials.
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
