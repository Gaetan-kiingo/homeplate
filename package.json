{
  "name": "homeplate",
  "version": "1.0.0",
  "private": true,
  "description": "Homeplate v1.0 — two-sided home-cooked-meal marketplace (MSCS 2101, Group 6). Modular Node.js/Express monolith per SRS v3.2 and ADR-001..011.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/seed.js",
    "seed:volume": "node scripts/seed.js --set volume",
    "build": "node scripts/check-build.js",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:coverage": "jest --coverage",
    "test:load": "k6 run tests/load/smoke.js",
    "test:a11y": "npx --yes @axe-core/cli http://localhost:5173",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "dev": "node scripts/dev.js",
    "worker": "node scripts/worker.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@node-rs/argon2": "^1.8.3",
    "@sendgrid/mail": "^8.1.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.3.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "pino": "^9.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "pino-pretty": "^11.2.1",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0"
  }
}
